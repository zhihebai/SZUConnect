    ]
   },
   "expected": {
    "state": "off",
    "kinds": [],
    "campusBypass": "notApplicable"
   }
  },
  {
   "id": "clash-http-https",
   "snapshot": {
    "readable": true,
    "http": true,
    "https": true,
    "exceptions": [
